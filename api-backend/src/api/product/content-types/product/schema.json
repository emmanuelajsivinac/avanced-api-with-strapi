{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "maxLength": 13,
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "maxLength": 250,
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "vendorCode": {
      "type": "string",
      "required": true
    },
    "salePrice": {
      "type": "decimal"
    },
    "wholesalePrice": {
      "type": "decimal"
    },
    "retailPrice": {
      "type": "decimal",
      "required": true
    },
    "referenceImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "type": {
      "type": "string",
      "maxLength": 50,
      "required": true
    }
  }
}
